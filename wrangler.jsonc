{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scoard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Environment variables for internal API routing
  // In production, Cloudflare automatically resolves the current domain
  "vars": {
    "API_BASE_URL": "https://scoard.kusham2301.workers.dev"
  }
}
